// ===========================
// STSphera — Prisma Schema
// 24 entities (section 6)
// Connected to Supabase PostgreSQL
// ===========================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------
// 1. Project
// -----------------------------------------------
model Project {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(20) // ProjectStatus
  startDate   DateTime? @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  facades          Facade[]
  workTypes        WorkType[]
  taskTemplates    TaskTemplate[]
  taskInstances    TaskInstance[]
  modulePlanItems  ModulePlanItem[]
  documents        Document[]
  moduleSummaries  ModuleSummary[]
  accSeries        AccumulativeSeries[]
  userRoles        UserRole[]
  importLogs       ImportLog[]

  @@map("projects")
}

// -----------------------------------------------
// 2. Facade
// -----------------------------------------------
model Facade {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  name         String   @db.VarChar(100)
  areaM2       Decimal? @map("area_m2") @db.Decimal(12, 2)
  moduleCount  Int?     @map("module_count")
  floors       String?  @db.VarChar(100)
  axes         String?  @db.VarChar(100)
  priority     String   @default("MEDIUM") @db.VarChar(10) // Priority
  plannedStart DateTime? @map("planned_start") @db.Date
  plannedEnd   DateTime? @map("planned_end") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project         Project          @relation(fields: [projectId], references: [id])
  taskInstances   TaskInstance[]
  dailyWorkLogs   DailyWorkLog[]
  modulePlanItems ModulePlanItem[]
  workVolumeContracts WorkVolumeContract[]
  accSeries       AccumulativeSeries[]

  @@map("facades")
}

// -----------------------------------------------
// 3. WorkType
// -----------------------------------------------
model WorkType {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  code      String   @db.VarChar(50)
  name      String   @db.Text
  unit      String?  @db.VarChar(20)
  phase     String?  @db.VarChar(100)
  priority  String   @default("MEDIUM") @db.VarChar(10) // Priority
  status    String   @default("ACTIVE") @db.VarChar(20)  // WorkTypeStatus
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project              Project              @relation(fields: [projectId], references: [id])
  workVolumeContracts  WorkVolumeContract[]
  taskTemplates        TaskTemplate[]

  @@unique([projectId, code])
  @@map("work_types")
}

// -----------------------------------------------
// 4. WorkVolumeContract
// -----------------------------------------------
model WorkVolumeContract {
  id              Int      @id @default(autoincrement())
  workTypeId      Int      @map("work_type_id")
  facadeId        Int?     @map("facade_id")
  contractVolume  Decimal  @map("contract_volume") @db.Decimal(14, 4)
  completedVolume Decimal  @default(0) @map("completed_volume") @db.Decimal(14, 4)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  workType WorkType @relation(fields: [workTypeId], references: [id])
  facade   Facade?  @relation(fields: [facadeId], references: [id])

  @@map("work_volume_contracts")
}

// -----------------------------------------------
// 5. DailyWorkLog
// -----------------------------------------------
model DailyWorkLog {
  id              Int      @id @default(autoincrement())
  taskInstanceId  Int      @map("task_instance_id")
  date            DateTime @db.Date
  dayOfWeek       String?  @map("day_of_week") @db.VarChar(20)
  workTypeCode    String?  @map("work_type_code") @db.VarChar(50)
  workName        String?  @map("work_name") @db.Text
  facadeId        Int?     @map("facade_id")
  floorZone       String?  @map("floor_zone") @db.VarChar(100)
  unit            String?  @db.VarChar(20)
  planDay         Decimal  @default(0) @map("plan_day") @db.Decimal(12, 4)
  factDay         Decimal  @default(0) @map("fact_day") @db.Decimal(12, 4)
  deviation       Decimal? @db.Decimal(12, 4)
  pctDay          Decimal? @map("pct_day") @db.Decimal(7, 2)
  accPlan         Decimal? @map("acc_plan") @db.Decimal(14, 4)
  accFact         Decimal? @map("acc_fact") @db.Decimal(14, 4)
  brigade         String?  @db.VarChar(100)
  notes           String?  @db.Text
  status          String   @default("DRAFT") @db.VarChar(20) // DailyWorkLogStatus
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  taskInstance TaskInstance @relation(fields: [taskInstanceId], references: [id])
  facade       Facade?      @relation(fields: [facadeId], references: [id])
  creator      User?        @relation("DailyWorkLogCreator", fields: [createdBy], references: [id])

  @@unique([taskInstanceId, date])
  @@index([date])
  @@index([facadeId, date])
  @@map("daily_work_logs")
}

// -----------------------------------------------
// 6. ModulePlanItem
// -----------------------------------------------
model ModulePlanItem {
  id                   Int       @id @default(autoincrement())
  projectId            Int       @map("project_id")
  phase                String?   @db.VarChar(100)
  moduleType           String    @map("module_type") @db.VarChar(100)
  code                 String    @db.VarChar(50)
  sizeMm               String?   @map("size_mm") @db.VarChar(100)
  quantity             Int
  axesFacade           String?   @map("axes_facade") @db.VarChar(100)
  facadeId             Int?      @map("facade_id")
  floors               String?   @db.VarChar(100)
  productionDate       DateTime? @map("production_date") @db.Date
  shipmentDate         DateTime? @map("shipment_date") @db.Date
  mountDate            DateTime? @map("mount_date") @db.Date
  actualProductionDate DateTime? @map("actual_production_date") @db.Date
  actualShipmentDate   DateTime? @map("actual_shipment_date") @db.Date
  actualMountDate      DateTime? @map("actual_mount_date") @db.Date
  smrLinkTaskId        Int?      @map("smr_link_task_id")
  status               String    @default("PLANNED") @db.VarChar(20) // ModuleStatus
  notes                String?   @db.Text
  facadeType           String?   @map("facade_type") @db.VarChar(100)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  project      Project       @relation(fields: [projectId], references: [id])
  facade       Facade?       @relation(fields: [facadeId], references: [id])
  smrLinkTask  TaskInstance?  @relation("ModuleSMRLink", fields: [smrLinkTaskId], references: [id])
  taskInstances TaskInstance[] @relation("TaskModuleLink")

  @@unique([projectId, code])
  @@index([projectId, status])
  @@map("module_plan_items")
}

// -----------------------------------------------
// 7. TaskTemplate
// -----------------------------------------------
model TaskTemplate {
  id                     Int      @id @default(autoincrement())
  projectId              Int      @map("project_id")
  code                   String   @db.VarChar(50)
  name                   String   @db.Text
  workTypeId             Int?     @map("work_type_id")
  unit                   String?  @db.VarChar(20)
  durationDays           Int?     @map("duration_days")
  defaultStart           DateTime? @map("default_start") @db.Date
  defaultEnd             DateTime? @map("default_end") @db.Date
  isSectionHeader        Boolean  @default(false) @map("is_section_header")
  sectionName            String?  @map("section_name") @db.Text
  parentTemplateId       Int?     @map("parent_template_id")
  sortOrder              Int      @map("sort_order")
  defaultResponsibleRole String?  @map("default_responsible_role") @db.VarChar(50)
  phase                  String?  @db.VarChar(100)
  priority               String   @default("MEDIUM") @db.VarChar(10) // Priority
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project        Project        @relation(fields: [projectId], references: [id])
  workType       WorkType?      @relation(fields: [workTypeId], references: [id])
  parentTemplate TaskTemplate?  @relation("TemplateHierarchy", fields: [parentTemplateId], references: [id])
  childTemplates TaskTemplate[] @relation("TemplateHierarchy")
  taskInstances  TaskInstance[]

  @@map("task_templates")
}

// -----------------------------------------------
// 8. TaskInstance
// -----------------------------------------------
model TaskInstance {
  id               Int       @id @default(autoincrement())
  templateId       Int?      @map("template_id")
  projectId        Int       @map("project_id")
  type             String    @default("TASK") @db.VarChar(20) // TaskInstanceType
  status           String    @default("CREATED") @db.VarChar(20) // TaskInstanceStatus
  assigneeId       Int?      @map("assignee_id")
  reviewerId       Int?      @map("reviewer_id")
  facadeId         Int?      @map("facade_id")
  floorZone        String?   @map("floor_zone") @db.VarChar(100)
  plannedStart     DateTime? @map("planned_start") @db.Date
  plannedEnd       DateTime? @map("planned_end") @db.Date
  actualStart      DateTime? @map("actual_start") @db.Date
  actualEnd        DateTime? @map("actual_end") @db.Date
  plannedVolume    Decimal?  @map("planned_volume") @db.Decimal(14, 4)
  actualVolume     Decimal   @default(0) @map("actual_volume") @db.Decimal(14, 4)
  completionPct    Decimal   @default(0) @map("completion_pct") @db.Decimal(5, 2)
  brigade          String?   @db.VarChar(100)
  modulePlanItemId Int?      @map("module_plan_item_id")
  priority         String    @default("MEDIUM") @db.VarChar(10) // Priority
  notes            String?   @db.Text
  createdBy        Int?      @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  template       TaskTemplate?   @relation(fields: [templateId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id])
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reviewer       User?           @relation("TaskReviewer", fields: [reviewerId], references: [id])
  facade         Facade?         @relation(fields: [facadeId], references: [id])
  modulePlanItem ModulePlanItem? @relation("TaskModuleLink", fields: [modulePlanItemId], references: [id])
  creator        User?           @relation("TaskCreator", fields: [createdBy], references: [id])

  dailyWorkLogs   DailyWorkLog[]
  predecessors    TaskDependency[] @relation("Successor")
  successors      TaskDependency[] @relation("Predecessor")
  moduleSMRLinks  ModulePlanItem[] @relation("ModuleSMRLink")
  documents       Document[]       @relation("TaskDocuments")
  notificationLogs NotificationLog[]

  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([plannedEnd])
  @@map("task_instances")
}

// -----------------------------------------------
// 9. TaskDependency
// -----------------------------------------------
model TaskDependency {
  id             Int    @id @default(autoincrement())
  predecessorId  Int    @map("predecessor_id")
  successorId    Int    @map("successor_id")
  dependencyType String @default("FS") @map("dependency_type") @db.VarChar(5) // DependencyType
  lagDays        Int    @default(0) @map("lag_days")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  predecessor TaskInstance @relation("Predecessor", fields: [predecessorId], references: [id])
  successor   TaskInstance @relation("Successor", fields: [successorId], references: [id])

  @@unique([predecessorId, successorId])
  @@map("task_dependencies")
}

// -----------------------------------------------
// 10. NotificationScenario
// -----------------------------------------------
model NotificationScenario {
  id                    Int      @id @default(autoincrement())
  code                  String   @unique @db.VarChar(50)
  taskName              String   @map("task_name") @db.Text
  triggerType           String   @map("trigger_type") @db.VarChar(20) // TriggerType
  notificationType      String?  @map("notification_type") @db.VarChar(100)
  recipientsConfig      Json?    @map("recipients_config") @db.JsonB
  messageTemplateId     Int?     @map("message_template_id")
  buttonsConfig         Json?    @map("buttons_config") @db.JsonB
  escalationConfig      Json?    @map("escalation_config") @db.JsonB
  escalationTimeMinutes Int?     @map("escalation_time_minutes")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()

  messageTemplate  MessageTemplate?  @relation(fields: [messageTemplateId], references: [id])
  notificationLogs NotificationLog[]

  @@map("notification_scenarios")
}

// -----------------------------------------------
// 11. NotificationSetting
// -----------------------------------------------
model NotificationSetting {
  id             Int     @id @default(autoincrement())
  parameter      String  @unique @db.VarChar(100)
  value          String  @db.Text
  description    String? @db.Text
  appliesTo      String? @map("applies_to") @db.VarChar(100)
  isConfigurable Boolean @default(true) @map("is_configurable")
  example        String? @db.Text

  @@map("notification_settings")
}

// -----------------------------------------------
// 12. MessageTemplate
// -----------------------------------------------
model MessageTemplate {
  id             Int      @id @default(autoincrement())
  messageType    String   @unique @map("message_type") @db.VarChar(100)
  templateText   String   @map("template_text") @db.Text
  variables      Json?    @db.JsonB
  exampleFilled  String?  @map("example_filled") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  scenarios NotificationScenario[]

  @@map("message_templates")
}

// -----------------------------------------------
// 13. NotificationLog
// -----------------------------------------------
model NotificationLog {
  id                 BigInt    @id @default(autoincrement())
  scenarioId         Int?      @map("scenario_id")
  userId             Int       @map("user_id")
  entityType         String?   @map("entity_type") @db.VarChar(50)
  entityId           Int?      @map("entity_id")
  taskInstanceId     Int?      @map("task_instance_id")
  messageText        String    @map("message_text") @db.Text
  buttonsJson        Json?     @map("buttons_json") @db.JsonB
  status             String    @default("PENDING") @db.VarChar(20) // NotificationDeliveryStatus
  telegramMessageId  BigInt?   @map("telegram_message_id")
  sentAt             DateTime? @map("sent_at") @db.Timestamptz()
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  scenario     NotificationScenario? @relation(fields: [scenarioId], references: [id])
  user         User                  @relation(fields: [userId], references: [id])
  taskInstance TaskInstance?          @relation(fields: [taskInstanceId], references: [id])

  @@index([userId, createdAt])
  @@map("notification_logs")
}

// -----------------------------------------------
// 14. User
// -----------------------------------------------
model User {
  id           Int       @id @default(autoincrement())
  telegramId   BigInt    @unique @map("telegram_id")
  firstName    String?   @map("first_name") @db.VarChar(100)
  lastName     String?   @map("last_name") @db.VarChar(100)
  username     String?   @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  fullName     String?   @map("full_name") @db.VarChar(255)
  departmentId Int?      @map("department_id")
  status       String    @default("PENDING") @db.VarChar(20) // UserStatus
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  department       Department?       @relation(fields: [departmentId], references: [id])
  userRoles        UserRole[]
  assignedTasks    TaskInstance[]     @relation("TaskAssignee")
  reviewTasks      TaskInstance[]     @relation("TaskReviewer")
  createdTasks     TaskInstance[]     @relation("TaskCreator")
  dailyWorkLogs    DailyWorkLog[]     @relation("DailyWorkLogCreator")
  documents        Document[]
  notificationLogs NotificationLog[]
  auditLogs        AuditLog[]
  importLogs       ImportLog[]
  assignedRoles    UserRole[]         @relation("RoleAssigner")

  @@map("users")
}

// -----------------------------------------------
// 15. Role
// -----------------------------------------------
model Role {
  id                    Int     @id @default(autoincrement())
  systemName            String  @unique @map("system_name") @db.VarChar(50)
  displayName           String  @map("display_name") @db.VarChar(100)
  description           String? @db.Text
  accessLevel           String? @map("access_level") @db.VarChar(50)
  receivesNotifications String? @map("receives_notifications") @db.Text

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

// -----------------------------------------------
// 16. Department
// -----------------------------------------------
model Department {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  users User[]

  @@map("departments")
}

// -----------------------------------------------
// 17. UserRole
// -----------------------------------------------
model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  roleId     Int      @map("role_id")
  projectId  Int      @map("project_id")
  facadeIds  Int[]    @map("facade_ids")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz()
  assignedBy Int?     @map("assigned_by")

  user     User    @relation(fields: [userId], references: [id])
  role     Role    @relation(fields: [roleId], references: [id])
  project  Project @relation(fields: [projectId], references: [id])
  assigner User?   @relation("RoleAssigner", fields: [assignedBy], references: [id])

  @@unique([userId, roleId, projectId])
  @@map("user_roles")
}

// -----------------------------------------------
// 18. RbacPermission
// -----------------------------------------------
model RbacPermission {
  id          Int     @id @default(autoincrement())
  resource    String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("rbac_permissions")
}

// -----------------------------------------------
// 19. RolePermission
// -----------------------------------------------
model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role           @relation(fields: [roleId], references: [id])
  permission RbacPermission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// -----------------------------------------------
// 20. AuditLog
// -----------------------------------------------
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  userId     Int?     @map("user_id")
  oldValue   Json?    @map("old_value") @db.JsonB
  newValue   Json?    @map("new_value") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

// -----------------------------------------------
// 21. Document
// -----------------------------------------------
model Document {
  id               Int      @id @default(autoincrement())
  projectId        Int      @map("project_id")
  name             String   @db.VarChar(255)
  type             String   @db.VarChar(10) // DocumentType
  url              String   @db.Text
  sizeBytes        BigInt?  @map("size_bytes")
  version          Int      @default(1)
  parentDocumentId Int?     @map("parent_document_id")
  status           String   @default("DRAFT") @db.VarChar(20) // DocumentStatus
  entityType       String?  @map("entity_type") @db.VarChar(50)
  entityId         Int?     @map("entity_id")
  taskInstanceId   Int?     @map("task_instance_id")
  uploadedBy       Int      @map("uploaded_by")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project        Project    @relation(fields: [projectId], references: [id])
  parentDocument Document?  @relation("DocumentVersions", fields: [parentDocumentId], references: [id])
  childVersions  Document[] @relation("DocumentVersions")
  uploader       User       @relation(fields: [uploadedBy], references: [id])
  taskInstance   TaskInstance? @relation("TaskDocuments", fields: [taskInstanceId], references: [id])

  @@map("documents")
}

// -----------------------------------------------
// 22. ImportLog
// -----------------------------------------------
model ImportLog {
  id              Int       @id @default(autoincrement())
  projectId       Int?      @map("project_id")
  fileName        String    @map("file_name") @db.VarChar(255)
  fileType        String?   @map("file_type") @db.VarChar(50) // ImportFileType
  status          String    @db.VarChar(20) // ImportStatus
  recordsTotal    Int       @default(0) @map("records_total")
  recordsImported Int       @default(0) @map("records_imported")
  recordsFailed   Int       @default(0) @map("records_failed")
  errorsJson      Json?     @map("errors_json") @db.JsonB
  warningsJson    Json?     @map("warnings_json") @db.JsonB
  uploadedBy      Int?      @map("uploaded_by")
  startedAt       DateTime? @map("started_at") @db.Timestamptz()
  completedAt     DateTime? @map("completed_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  project  Project? @relation(fields: [projectId], references: [id])
  uploader User?    @relation(fields: [uploadedBy], references: [id])

  @@map("import_logs")
}

// -----------------------------------------------
// 23. ModuleSummary
// -----------------------------------------------
model ModuleSummary {
  id           Int      @id @default(autoincrement())
  projectId    Int      @map("project_id")
  name         String   @db.VarChar(255)
  moduleType   String?  @map("module_type") @db.VarChar(100)
  totalCount   Int      @default(0) @map("total_count")
  mountedCount Int      @default(0) @map("mounted_count")
  missingCount Int      @default(0) @map("missing_count")
  unit         String?  @db.VarChar(20)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id])

  @@map("module_summaries")
}

// -----------------------------------------------
// 24. AccumulativeSeries
// -----------------------------------------------
model AccumulativeSeries {
  id             BigInt    @id @default(autoincrement())
  projectId      Int       @map("project_id")
  facadeId       Int?      @map("facade_id")
  metricName     String    @map("metric_name") @db.VarChar(100)
  date           DateTime  @db.Date
  value          Decimal?  @db.Decimal(14, 4)
  stockAvailable Decimal?  @map("stock_available") @db.Decimal(14, 4)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id])
  facade  Facade? @relation(fields: [facadeId], references: [id])

  @@unique([projectId, facadeId, metricName, date])
  @@map("accumulative_series")
}
